{
  "title": "Universities and boards that set syllabi and run exams (source/exam-bodies.json)",
  "type": "object",
  "required": ["examBodies"],
  "additionalProperties": false,
  "properties": {
    "examBodies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "shortName", "website"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string", "minLength": 1 },
          "website": { "type": "string", "pattern": "^https://" },
          "examPage": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  }
}
