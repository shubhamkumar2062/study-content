{
  "title": "Multiple-choice questions of one subject (mcqs.json)",
  "type": "object",
  "required": ["mcqs"],
  "additionalProperties": false,
  "properties": {
    "mcqs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "unit", "question", "options", "correct", "explanation", "probability"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "unit": { "type": "integer", "minimum": 1, "maximum": 20 },
          "question": { "type": "string", "minLength": 5 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1 }
          },
          "correct": { "description": "Index of the right option, counted from 0", "type": "integer", "minimum": 0 },
          "explanation": { "type": "string", "minLength": 5 },
          "probability": { "enum": ["high", "medium", "low"] },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
