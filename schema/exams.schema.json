{
  "title": "Exam date sheets of one exam body (source/exams/<bodyId>.json)",
  "type": "object",
  "required": ["bodyId", "sessions"],
  "additionalProperties": false,
  "properties": {
    "bodyId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "lastChecked", "officialUrl", "papers"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["tentative", "final", "revised"] },
          "publishedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "lastChecked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "officialUrl": { "type": "string", "pattern": "^https://" },
          "note": { "type": "string" },
          "papers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["date", "start", "end", "programmeId", "schemeId", "termId", "subjectCode", "title"],
              "additionalProperties": false,
              "properties": {
                "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
                "end": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
                "programmeId": { "type": "string" },
                "schemeId": { "type": "string" },
                "termId": { "type": "string" },
                "subjectCode": { "type": "string" },
                "title": { "type": "string", "minLength": 1 },
                "paperType": { "enum": ["regular", "re-appear"] }
              }
            }
          }
        }
      }
    }
  }
}
