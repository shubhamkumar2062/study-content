{
  "title": "Mock test patterns of one subject (mocktests.json). The app builds each attempt by drawing questions from the subject's banks.",
  "type": "object",
  "required": ["tests"],
  "additionalProperties": false,
  "properties": {
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "durationMinutes", "totalMarks", "sections"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "patternSource": { "type": "string" },
          "durationMinutes": { "type": "integer", "minimum": 5, "maximum": 240 },
          "totalMarks": { "type": "integer", "minimum": 1 },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "source", "marksEach", "count", "attempt"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "title": { "type": "string", "minLength": 1 },
                "source": {
                  "description": "Which bank the questions come from",
                  "enum": ["mcq", "very-short", "short", "long"]
                },
                "marksEach": { "type": "integer", "minimum": 1 },
                "count": { "description": "How many questions the paper shows", "type": "integer", "minimum": 1 },
                "attempt": { "description": "How many the student answers", "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
