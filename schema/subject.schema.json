{
  "title": "One subject's metadata (source/subjects/<stream>/<programme>/<scheme>/<term>/<code>/subject.json)",
  "type": "object",
  "required": ["code", "title", "reviewed", "units"],
  "additionalProperties": false,
  "properties": {
    "code": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "reviewed": {
      "description": "true only after a subject teacher has checked every file of this subject. Release builds of the app hide subjects that are not reviewed.",
      "type": "boolean"
    },
    "reviewedBy": { "type": "string" },
    "syllabusSource": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "practicalCodes": {
      "description": "Codes of practical subjects whose guides live in this pack",
      "type": "array",
      "items": { "type": "string" }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "title", "notes"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1, "maximum": 20 },
          "title": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "pattern": "^notes/[a-z0-9-]+\\.md$" }
        }
      }
    },
    "extras": {
      "description": "Notes that are not one unit, e.g. how to use, revision sheet",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "notes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "pattern": "^notes/[a-z0-9-]+\\.md$" }
        }
      }
    },
    "practicals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "file"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "pattern": "^practicals/[a-z0-9-]+\\.md$" }
        }
      }
    }
  }
}
